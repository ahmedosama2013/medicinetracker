# Local dev / Supabase CLI only. The client-side equivalents of the first
# three values live in js/config.js (checked into the repo -- they're public,
# safe-to-expose values, not secrets). This file is for the Supabase CLI and
# is never read by the browser.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Dashboard > Project Settings > API. Only ever used server-side (Edge
# Functions, local migrations) -- never ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_CONTACT_EMAIL=you@example.com
